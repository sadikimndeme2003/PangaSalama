# Flask
SECRET_KEY=badilisha_hii_kwa_something_ngumu

# Supabase (Project Settings -> API Keys)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=service_role_key_yako

# Cloudinary (Dashboard -> Account Details)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Tengeneza "unsigned upload preset" (Settings -> Upload -> Upload presets ->
# Add upload preset -> Signing Mode: Unsigned) -- inaruhusu simu ya mwenye
# chumba kupakia picha/video moja kwa moja Cloudinary bila kupitia server.
CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset_name

# Namba ya WhatsApp ya ADMIN (mfano: 255712345678 au 0712345678) -- vitufe
# vya "Piga Simu"/"WhatsApp" kwenye ukurasa wa chumba vinaelekeza hapa,
# siyo kwa mwenye nyumba, ili admin abaki daraja pekee.
ADMIN_WHATSAPP_NUMBER=0712345678

# Weka "development" tu ukiwa unaendesha localhost bila HTTPS (Termux/PC).
# Usiweke kwenye Vercel -- huko lazima ibaki wazi (production) kwa usalama
# wa session cookie (Secure flag).
FLASK_ENV=production

# Weka "true" MUDA MFUPI TU unapotaka kuona traceback halisi ya Python
# kwenye browser badala ya "Internal Server Error" ya jumla (kwa ku-debug).
# ZIMA (futa au weka false) baada ya kumaliza -- traceback inaweza kuonyesha
# maelezo ya ndani ya code ambayo hayapaswi kuwa wazi kwa umma.
DEBUG_ERRORS=false
